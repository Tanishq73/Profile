# Copy to .env and fill in. Never commit .env. Values here are never written to logs.

# Telegram (required to send; --dry-run works without them). See README "Telegram setup".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM rephrasing of the computed signals. Off by default.
# groq  -> https://console.groq.com   (free tier, no card)
# gemini -> https://aistudio.google.com (free tier, no card)
LLM_PROVIDER=none
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional dead-man's switch (healthchecks.io free tier). One URL for all jobs,
# or a separate check per job (recommended: each has its own schedule).
HEALTHCHECKS_URL=
HEALTHCHECKS_URL_MORNING=
HEALTHCHECKS_URL_CLOSE=
HEALTHCHECKS_URL_WEEKLY=
